{
    "name": "yunwuxin/think-auth",
    "license": "Apache-2.0",
    "description": "The Auth Library For ThinkPHP",
    "authors": [
        {
            "name": "yunwuxin",
            "email": "448901948@qq.com"
        }
    ],
    "require": {
        "topthink/framework": "^6.0 || ^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "yunwuxin\\": "src"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "extra": {
        "think": {
            "config": {
                "auth": "src/config.php"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
